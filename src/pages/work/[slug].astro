---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/frappe/projects';
import type { Project } from '../../lib/frappe/types';
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props as { item: Project };
---
<BaseLayout description={item.short_description}>
  <article class="case-page">
    <a class="text-link" href="/#work">← BACK TO WORK</a>
    <div class="case-heading"><p class="eyebrow">PROJECT / {item.status}</p><h1>{item.title}<span class="accent">.</span></h1><p>{item.short_description}</p>{item.live_url && <a class="text-link case-site-link" href={item.live_url} target="_blank" rel="noopener noreferrer">VISIT PROJECT WEBSITE <span aria-hidden="true">↗</span></a>}</div>
    <div class="case-content"><div class="case-facts"><div><span>STACK</span><p>{item.technologies}</p></div>{item.year && <div><span>YEAR</span><p>{item.year}</p></div>}<div><span>STATUS</span><p>{item.status}</p></div></div><div class="case-story"><p>{item.description}</p>{item.slug === 'consolestore' && <div class="terminal-line"><span>$</span> console order lunch <span class="terminal-cursor">_</span></div>}{item.github_url && <a class="text-link" href={item.github_url} target="_blank" rel="noopener noreferrer">VIEW SOURCE <span aria-hidden="true">↗</span></a>}</div></div>
  </article>
</BaseLayout>
